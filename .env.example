# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 Git에 올리지 않습니다)
# 값은 Supabase 대시보드 > Project Settings > API Keys / Data API 에서 확인합니다.
# NEXT_PUBLIC_ 접두어를 붙이지 마세요. 붙이면 화면(브라우저) 코드로 키가 노출됩니다.

# 프로젝트 주소 (예: https://abcdefghijklmnop.supabase.co)
SUPABASE_URL=

# Publishable key (sb_publishable_... 로 시작) 또는 예전 방식의 anon key
# secret / service_role 키는 RLS를 무시하므로 절대 넣지 마세요.
SUPABASE_PUBLISHABLE_KEY=

# 배포 후 사이트 주소 (예: https://my-todo.onrender.com). 로컬에서는 비워 두면 됩니다.
SITE_URL=
